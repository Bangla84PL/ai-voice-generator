# =============================================================================
# AI VOICE GENERATOR - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local for development or .env.production for production
# NEVER commit actual secrets to git!

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Voice Generator

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings
# For VPS deployment: https://api.supabase.smartcamp.ai
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# Database (if direct access needed - usually not required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# AI Voice Provider (Choose one or configure both)
# -----------------------------------------------------------------------------
# OpenAI TTS (Primary)
OPENAI_API_KEY=sk-...

# ElevenLabs (Alternative/Premium)
ELEVENLABS_API_KEY=...

# Voice provider selection: 'openai' or 'elevenlabs'
AI_VOICE_PROVIDER=openai

# -----------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (from Stripe Dashboard)
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ID_CREDITS_100K=price_...
STRIPE_PRICE_ID_CREDITS_500K=price_...

# -----------------------------------------------------------------------------
# Email Service (Choose one)
# -----------------------------------------------------------------------------
# Resend (Recommended)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_...
EMAIL_FROM=noreply@smartcamp.ai
EMAIL_FROM_NAME=SmartCamp.AI Voice Generator

# SendGrid (Alternative)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG...
# EMAIL_FROM=noreply@smartcamp.ai

# -----------------------------------------------------------------------------
# n8n Integration (Workflow Automation)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_BASE_URL=https://n8n.smartcamp.ai/webhook/
N8N_WEBHOOK_SECRET=your-webhook-secret-key

# Individual webhook URLs (auto-constructed from base URL)
# N8N_WEBHOOK_USER_ONBOARDING=${N8N_WEBHOOK_BASE_URL}user-onboarding
# N8N_WEBHOOK_GENERATION_COMPLETE=${N8N_WEBHOOK_BASE_URL}generation-complete
# N8N_WEBHOOK_CREDIT_THRESHOLD=${N8N_WEBHOOK_BASE_URL}credit-threshold
# N8N_WEBHOOK_SUBSCRIPTION_CHANGED=${N8N_WEBHOOK_BASE_URL}subscription-changed

# -----------------------------------------------------------------------------
# Gotenberg (PDF Generation)
# -----------------------------------------------------------------------------
GOTENBERG_API_URL=http://gotenberg:3000
# For local development: http://localhost:3000
# For VPS production: https://gotenberg.smartcamp.ai

# -----------------------------------------------------------------------------
# Flowise (AI Chatbot)
# -----------------------------------------------------------------------------
FLOWISE_API_URL=https://flowise.smartcamp.ai
FLOWISE_CHATFLOW_ID=your-chatflow-id
NEXT_PUBLIC_FLOWISE_CHATFLOW_ID=your-chatflow-id

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=voice.smartcamp.ai
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# Sentry (Error Tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=...

# PostHog (Product Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_VOICE_CLONING=false
ENABLE_API_ACCESS=true
ENABLE_BATCH_PROCESSING=true
ENABLE_TEAM_FEATURES=false
ENABLE_CHATBOT=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GENERATION_MAX_CONCURRENT=10
RATE_LIMIT_GENERATION_MAX_HOURLY=100

# API Key rate limits (Pro tier)
RATE_LIMIT_API_KEY_WINDOW=3600000
RATE_LIMIT_API_KEY_MAX_REQUESTS=1000

# -----------------------------------------------------------------------------
# File Storage & Processing
# -----------------------------------------------------------------------------
# Max file sizes (in bytes)
MAX_TEXT_LENGTH=10000
MAX_VOICE_SAMPLE_SIZE=10485760
MAX_BATCH_SIZE=50

# Audio format settings
DEFAULT_AUDIO_FORMAT=mp3
DEFAULT_AUDIO_QUALITY=256

# Storage retention (in days)
STORAGE_RETENTION_FREE_TIER=90
STORAGE_RETENTION_PRO_TIER=365
STORAGE_RETENTION_ENTERPRISE_TIER=730

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://voice.smartcamp.ai

# Session configuration
SESSION_COOKIE_NAME=sb-auth-token
SESSION_MAX_AGE=604800

# API key configuration
API_KEY_PREFIX=vgen_
API_KEY_LENGTH=32

# -----------------------------------------------------------------------------
# Development & Debugging
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=info
PRETTY_LOGS=true

# Skip email sending in development
SKIP_EMAIL_SENDING=false

# Use mock AI provider (for testing without API costs)
USE_MOCK_AI_PROVIDER=false

# -----------------------------------------------------------------------------
# Credits & Billing
# -----------------------------------------------------------------------------
# Free tier monthly credits
FREE_TIER_MONTHLY_CREDITS=10000

# Pro tier monthly credits
PRO_TIER_MONTHLY_CREDITS=500000

# Character to credit ratio (1 credit = 1 character)
CREDITS_PER_CHARACTER=1

# Welcome bonus credits
NEW_USER_BONUS_CREDITS=1000

# -----------------------------------------------------------------------------
# Voice Generation Settings
# -----------------------------------------------------------------------------
# Default voice settings
DEFAULT_VOICE_ID=default-voice-uuid
DEFAULT_VOICE_SPEED=1.0
DEFAULT_VOICE_PITCH=1.0

# Generation timeouts (in milliseconds)
GENERATION_TIMEOUT_SHORT=10000
GENERATION_TIMEOUT_LONG=60000

# Polling intervals (in milliseconds)
GENERATION_POLL_INTERVAL_INITIAL=2000
GENERATION_POLL_INTERVAL_MAX=10000

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
# Webhook retry settings
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# Webhook timeout (in milliseconds)
WEBHOOK_TIMEOUT=5000

# -----------------------------------------------------------------------------
# Cache Configuration (Optional - Redis)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# CACHE_TTL_SHORT=300
# CACHE_TTL_MEDIUM=3600
# CACHE_TTL_LONG=86400
