{
  "name": "User Onboarding",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "user-onboarding",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "user-onboarding"
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "requestMethod": "POST",
        "url": "={{ $env.EMAIL_API_URL }}/send",
        "jsonParameters": true,
        "options": {},
        "headerParametersJson": "={{ { \"Authorization\": \"Bearer \" + $env.EMAIL_API_KEY, \"Content-Type\": \"application/json\" } }}",
        "bodyParametersJson": "={{ {\n  \"from\": $env.EMAIL_FROM,\n  \"to\": $json.body.email,\n  \"subject\": \"Welcome to AI Voice Generator\",\n  \"html\": \"<h1>Welcome \" + $json.body.name + \"!</h1><p>Thank you for signing up. Your account has been created successfully.</p><p>You've received \" + $json.body.bonusCredits + \" bonus credits to get started!</p><p><a href='\" + $json.body.dashboardUrl + \"'>Go to Dashboard</a></p>\",\n  \"tags\": [{\"name\": \"category\", \"value\": \"welcome\"}, {\"name\": \"user_id\", \"value\": $json.body.userId}]\n} }}"
      },
      "id": "send-welcome-email",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/contacts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.CRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "name",
              "value": "={{ $json.body.name }}"
            },
            {
              "name": "userId",
              "value": "={{ $json.body.userId }}"
            },
            {
              "name": "signupDate",
              "value": "={{ $json.body.createdAt }}"
            },
            {
              "name": "plan",
              "value": "free"
            }
          ]
        },
        "options": {}
      },
      "id": "create-crm-entry",
      "name": "Create CRM Entry (Optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "continueOnFail": true,
      "notes": "Optional - Configure CRM_API_URL and CRM_API_KEY in environment variables"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_LIST_API_URL }}/subscribers",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.EMAIL_LIST_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "name",
              "value": "={{ $json.body.name }}"
            },
            {
              "name": "tags",
              "value": "new-user,free-tier"
            }
          ]
        },
        "options": {}
      },
      "id": "add-to-email-list",
      "name": "Add to Email List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 400],
      "continueOnFail": true,
      "notes": "Optional - Configure EMAIL_LIST_API_URL and EMAIL_LIST_API_KEY for your email marketing platform"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"User onboarding workflow completed\", \"userId\": $json.body.userId } }}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
