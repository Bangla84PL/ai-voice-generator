        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.CRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
