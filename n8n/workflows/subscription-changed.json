        "options": {},
        "headerParametersJson": "={{ { \"Authorization\": \"Bearer \" + $env.EMAIL_API_KEY, \"Content-Type\": \"application/json\" } }}",
        "bodyParametersJson": "={{ {\n  \"from\": $env.EMAIL_FROM,\n  \"to\": $json.body.email,\n  \"subject\": \"Subscription Confirmed - AI Voice Generator\",\n  \"html\": \"<h1>Subscription Confirmed!</h1><p>Hi \" + $json.body.name + \",</p><p>Thank you for subscribing to AI Voice Generator!</p><div style='background-color: #d1fae5; padding: 16px; border-radius: 6px;'><h3>Subscription Details</h3><p><strong>Plan:</strong> \" + $json.body.planName + \"</p><p><strong>Amount:</strong> $\" + ($json.body.amount / 100).toFixed(2) + \"/\" + $json.body.interval + \"</p><p><strong>Monthly Credits:</strong> \" + $json.body.newCredits + \"</p><p><strong>Next Billing Date:</strong> \" + new Date($json.body.nextBillingDate).toLocaleDateString() + \"</p></div><h3>What's Included</h3><ul><li>\" + $json.body.newCredits + \" credits per month</li><li>Access to all voice options</li><li>Priority support</li><li>Advanced features and customization</li></ul><p><a href='\" + $json.body.manageUrl + \"'>Manage Subscription</a></p>\",\n  \"tags\": [{\"name\": \"category\", \"value\": \"subscription\"}, {\"name\": \"plan\", \"value\": $json.body.planName}]\n} }}"
      },
      "id": "send-confirmation-email",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
